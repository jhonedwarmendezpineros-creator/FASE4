        r.confirmar()
        r.procesar()
    prueba(8, "Crear, confirmar y procesar reserva", op8)

    def op9():
        r = sistema.crear_reserva("R002", "C002", "S002", 3)
        r.confirmar()
    prueba(9, "Crear y confirmar reserva", op9)
    prueba(10, "Rechazar duración cero", lambda: sistema.crear_reserva("R003", "C001", "S001", 0))
    prueba(11, "Rechazar servicio inexistente", lambda: sistema.crear_reserva("R004", "C001", "S999", 1))

    def op12():
        r = sistema.crear_reserva("R005", "C001", "S003", 1)
