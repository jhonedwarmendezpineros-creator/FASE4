# EXCEPCIONES PERSONALIZADAS
class ErrorSistema(Exception):
    """Excepción base del sistema."""


class DatosInvalidosError(ErrorSistema):
    """Datos que no cumplen las validaciones."""


class ServicioNoDisponibleError(ErrorSistema):
    """Servicio no disponible para reservar."""


class ReservaNoPermitidaError(ErrorSistema):
    """Acción no permitida sobre una reserva."""


class ElementoNoEncontradoError(ErrorSistema):
    """No se encontró un elemento solicitado."""


# ABSTRACCIÓN: ENTIDAD GENERAL
class Entidad(ABC):
    def __init__(self, identificador):
        if not isinstance(identificador, str) or not identificador.strip():
            raise DatosInvalidosError("El identificador es obligatorio.")
        self._identificador = identificador.strip()

    @property
    def identificador(self):
        return self._identificador

    @abstractmethod
    def describir(self):
        pass


# CLIENTE: ENCAPSULAMIENTO Y VALIDACIONES
class Cliente(Entidad):
    def __init__(self, identificador, nombre, correo, telefono):
        super().__init__(identificador)
        self.nombre = nombre
        self.correo = correo
        self.telefono = telefono

    @property
    def nombre(self):
        return self._nombre

    @nombre.setter
    def nombre(self, valor):
        if not isinstance(valor, str) or len(valor.strip()) < 3:
            raise DatosInvalidosError("El nombre debe tener al menos 3 caracteres.")
        self._nombre = valor.strip().title()

    @property
    def correo(self):
        return self._correo

    @correo.setter
    def correo(self, valor):
        if not isinstance(valor, str) or "@" not in valor or "." not in valor.split("@")[-1]:
            raise DatosInvalidosError("El correo electrónico no es válido.")
        self._correo = valor.strip().lower()

    @property
    def telefono(self):
        return self._telefono

    @telefono.setter
    def telefono(self, valor):
        numero = str(valor).strip()
        if not numero.isdigit() or not 7 <= len(numero) <= 15:
            raise DatosInvalidosError("El teléfono debe contener entre 7 y 15 dígitos.")
        self._telefono = numero

    def describir(self):
        return f"{self.identificador}: {self.nombre} | {self.correo} | {self.telefono}"


# VARIANTES DE CÁLCULO CON PARÁMETROS OPCIONALES
def calcular_total(valor_base, impuesto=0, descuento=0):
    """Python no tiene sobrecarga tradicional por firma; se usan opcionales."""
    if isinstance(valor_base, bool) or not isinstance(valor_base, (int, float)) or valor_base <= 0:
        raise DatosInvalidosError("El valor base debe ser positivo.")
    if not isinstance(impuesto, (int, float)) or not 0 <= impuesto <= 100:
        raise DatosInvalidosError("El impuesto debe estar entre 0 y 100%.")
    if not isinstance(descuento, (int, float)) or not 0 <= descuento <= 100:
        raise DatosInvalidosError("El descuento debe estar entre 0 y 100%.")
    return round(valor_base * (1 + impuesto / 100) * (1 - descuento / 100), 2)


def validar_duracion(duracion, maximo, mensaje):
    if isinstance(duracion, bool) or not isinstance(duracion, (int, float)) or duracion <= 0:
        raise DatosInvalidosError("La duración debe ser un número mayor que cero.")
    if duracion > maximo:
        raise DatosInvalidosError(mensaje)


# SERVICIO ABSTRACTO Y CLASES DERIVADAS (HERENCIA Y POLIMORFISMO)
class Servicio(Entidad, ABC):
    def __init__(self, identificador, nombre, tarifa_base, disponible=True):
        super().__init__(identificador)
        if not isinstance(nombre, str) or not nombre.strip():
            raise DatosInvalidosError("El nombre del servicio es obligatorio.")
        if isinstance(tarifa_base, bool) or not isinstance(tarifa_base, (int, float)) or tarifa_base <= 0:
            raise DatosInvalidosError("La tarifa debe ser un número positivo.")
        self.nombre = nombre.strip()
        self.tarifa_base = float(tarifa_base)
        self.disponible = bool(disponible)

    @abstractmethod
    def validar_parametros(self, duracion):
        pass

    @abstractmethod
    def calcular_costo(self, duracion, impuesto=0, descuento=0):
        pass

    def describir(self):
        estado = "Disponible" if self.disponible else "No disponible"
        return f"{self.identificador}: {self.nombre} | ${self.tarifa_base:,.2f} | {estado}"


class ReservaSala(Servicio):
    def validar_parametros(self, duracion):
        validar_duracion(duracion, 12, "La reserva de sala no puede superar 12 horas.")

    def calcular_costo(self, duracion, impuesto=0, descuento=0):
        self.validar_parametros(duracion)
        return calcular_total(self.tarifa_base * duracion, impuesto, descuento)


class AlquilerEquipo(Servicio):
    def validar_parametros(self, duracion):
        validar_duracion(duracion, 30, "El alquiler no puede superar 30 días.")

    def calcular_costo(self, duracion, impuesto=0, descuento=0):
        self.validar_parametros(duracion)
        return calcular_total(self.tarifa_base * duracion, impuesto, descuento)


class AsesoriaEspecializada(Servicio):
    def validar_parametros(self, duracion):
        validar_duracion(duracion, 20, "No se pueden programar más de 20 sesiones.")

    def calcular_costo(self, duracion, impuesto=0, descuento=0):
        self.validar_parametros(duracion)
        return calcular_total(self.tarifa_base * duracion, impuesto, descuento)


# RESERVA
class Reserva(Entidad):
    def __init__(self, identificador, cliente, servicio, duracion):
        super().__init__(identificador)
        if not isinstance(cliente, Cliente):
            raise DatosInvalidosError("Debe asociarse un cliente válido.")
        if not isinstance(servicio, Servicio):
            raise DatosInvalidosError("Debe asociarse un servicio válido.")
        servicio.validar_parametros(duracion)
        self.cliente = cliente
        self.servicio = servicio
        self.duracion = duracion
        self.estado = "Pendiente"
        self.costo = servicio.calcular_costo(duracion)

    def confirmar(self):
        if self.estado != "Pendiente":
            raise ReservaNoPermitidaError("Solo se confirman reservas pendientes.")
        if not self.servicio.disponible:
            raise ServicioNoDisponibleError("El servicio no está disponible.")
        self.estado = "Confirmada"
        logging.info("Reserva %s confirmada.", self.identificador)

    def cancelar(self):
        if self.estado == "Cancelada":
            raise ReservaNoPermitidaError("La reserva ya está cancelada.")
        if self.estado == "Procesada":
            raise ReservaNoPermitidaError("No se puede cancelar una reserva procesada.")
        self.estado = "Cancelada"
        logging.info("Reserva %s cancelada.", self.identificador)

    def procesar(self):
        if self.estado != "Confirmada":
            raise ReservaNoPermitidaError("La reserva debe estar confirmada.")
        self.estado = "Procesada"
        logging.info("Reserva %s procesada.", self.identificador)

    def describir(self):
        return f"{self.identificador} | {self.cliente.nombre} | {self.servicio.nombre} | {self.estado}"


# GESTOR: LISTAS EN MEMORIA, SIN BASE DE DATOS
class SistemaSoftwareFJ:
    def __init__(self):
        self.clientes = []
        self.servicios = []
        self.reservas = []

    def registrar_cliente(self, cliente):
        if any(c.identificador == cliente.identificador for c in self.clientes):
            raise DatosInvalidosError("Ya existe ese cliente.")
        self.clientes.append(cliente)
        logging.info("Cliente registrado: %s", cliente.identificador)

    def registrar_servicio(self, servicio):
        if any(s.identificador == servicio.identificador for s in self.servicios):
            raise DatosInvalidosError("Ya existe ese servicio.")
        self.servicios.append(servicio)
        logging.info("Servicio registrado: %s", servicio.identificador)

    def crear_reserva(self, identificador, id_cliente, id_servicio, duracion):
        try:
            cliente = next(c for c in self.clientes if c.identificador == id_cliente)
            servicio = next(s for s in self.servicios if s.identificador == id_servicio)
            if any(r.identificador == identificador for r in self.reservas):
                raise DatosInvalidosError("Ya existe esa reserva.")
            reserva = Reserva(identificador, cliente, servicio, duracion)
            self.reservas.append(reserva)
            logging.info("Reserva creada: %s", identificador)
            return reserva
        except StopIteration as error:
            logging.exception("Cliente o servicio no encontrado.")
            raise ElementoNoEncontradoError("No se encontró el cliente o servicio.") from error

    def buscar_reserva(self, identificador):
        for reserva in self.reservas:
            if reserva.identificador == identificador:
                return reserva
        raise ElementoNoEncontradoError("No existe la reserva seleccionada.")


