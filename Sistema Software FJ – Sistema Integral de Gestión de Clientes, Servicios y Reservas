    def error(self, titulo, error):
        logging.exception("%s: %s", titulo, error)
        messagebox.showerror(titulo, str(error))

    def registrar_cliente(self):
        try:
            c = Cliente(self.cli_id.get(), self.cli_nombre.get(),
                        self.cli_correo.get(), self.cli_telefono.get())
            self.sistema.registrar_cliente(c)
        except ErrorSistema as exc:
            self.error("Error al registrar cliente", exc)
        else:
            messagebox.showinfo("Correcto", "Cliente registrado.")
            self.cli_id.set(""); self.cli_nombre.set("")
            self.cli_correo.set(""); self.cli_telefono.set("")
            self.actualizar_tablas()
        finally:
            logging.info("Finalizó intento de registro de cliente.")

    def registrar_servicio(self):
        try:
            tarifa = float(self.ser_tarifa.get().replace(",", "."))
            clases = {"Sala": ReservaSala, "Alquiler de equipo": AlquilerEquipo,
                      "Asesoría especializada": AsesoriaEspecializada}
            s = clases[self.ser_tipo.get()](
                self.ser_id.get(), self.ser_nombre.get(), tarifa, self.ser_disponible.get())
            self.sistema.registrar_servicio(s)
        except ValueError:
            self.error("Dato inválido", DatosInvalidosError("La tarifa debe ser numérica."))
        except ErrorSistema as exc:
            self.error("Error al registrar servicio", exc)
        else:
            messagebox.showinfo("Correcto", "Servicio registrado.")
            self.ser_id.set(""); self.ser_nombre.set(""); self.ser_tarifa.set("")
            self.actualizar_tablas()
        finally:
            logging.info("Finalizó intento de registro de servicio.")

    def crear_reserva(self):
        try:
            duracion = float(self.res_duracion.get().replace(",", "."))
            idc = self.res_cliente.get().split(" | ")[0]
            ids = self.res_servicio.get().split(" | ")[0]
            r = self.sistema.crear_reserva(self.res_id.get(), idc, ids, duracion)
        except ValueError:
            self.error("Dato inválido", DatosInvalidosError("La duración debe ser numérica."))
        except ErrorSistema as exc:
            self.error("Error al crear reserva", exc)
        else:
            messagebox.showinfo("Reserva creada",
                                f"Reserva {r.identificador} creada.\nEstado: {r.estado}\nCosto: ${r.costo:,.2f}")
            self.res_id.set(""); self.res_duracion.set("")
            self.actualizar_tablas()
        finally:
            logging.info("Finalizó intento de creación de reserva.")

    def estado_reserva(self, accion):
        seleccion = self.tabla_reservas.selection()
        if not seleccion:
            messagebox.showwarning("Seleccione una reserva", "Seleccione una fila de la tabla.")
            return
        rid = self.tabla_reservas.item(seleccion[0], "values")[0]
        try:
            r = self.sistema.buscar_reserva(rid)
            if accion == "confirmar":
                r.confirmar()
            elif accion == "cancelar":
                r.cancelar()
            else:
                r.procesar()
        except ErrorSistema as exc:
            self.error("No se pudo cambiar el estado", exc)
        else:
            messagebox.showinfo("Correcto", f"Reserva {rid}: {r.estado}.")
            self.actualizar_tablas()
        finally:
            logging.info("Finalizó acción %s sobre reserva %s.", accion, rid)

    def actualizar_tablas(self):
        for tabla in (self.tabla_clientes, self.tabla_servicios, self.tabla_reservas):
            for item in tabla.get_children():
                tabla.delete(item)
        for c in self.sistema.clientes:
            self.tabla_clientes.insert("", "end", values=(c.identificador, c.nombre, c.correo, c.telefono))
        for s in self.sistema.servicios:
            self.tabla_servicios.insert("", "end",
                values=(s.identificador, s.nombre, type(s).__name__,
                        f"${s.tarifa_base:,.2f}", "Disponible" if s.disponible else "No disponible"))
        for r in self.sistema.reservas:
            self.tabla_reservas.insert("", "end",
                values=(r.identificador, r.cliente.nombre, r.servicio.nombre,
                        r.duracion, r.estado, f"${r.costo:,.2f}"))
        self.combo_clientes["values"] = [f"{c.identificador} | {c.nombre}" for c in self.sistema.clientes]
        self.combo_servicios["values"] = [f"{s.identificador} | {s.nombre}" for s in self.sistema.servicios]

    def demostracion(self):
        try:
            resultados = ejecutar_demostracion()
        except Exception as exc:
            logging.exception("Fallo inesperado en demostración.")
            messagebox.showerror("Error", "Revise el archivo software_fj.log.")
        else:
            self.salida_demo.configure(state="normal")
            self.salida_demo.delete("1.0", "end")
            self.salida_demo.insert("end", "\n".join(resultados))
            self.salida_demo.insert("end", "\n\nDEMOSTRACIÓN FINALIZADA: 15 operaciones.")
            self.salida_demo.configure(state="disabled")
            messagebox.showinfo("Demostración", "Se ejecutaron las 15 operaciones. Consulte la pestaña y el log.")
        finally:
            logging.info("Finalizó demostración desde la interfaz.")

    def cerrar(self):
        logging.info("Aplicación cerrada por el usuario.")
        self.root.destroy()


def main():
    ventana = tk.Tk()
    AplicacionSoftwareFJ(ventana)
    ventana.mainloop()


if __name__ == "__main__":
    try:
        main()
    except Exception:
        logging.exception("Error no controlado al iniciar Software FJ.")
        raise
