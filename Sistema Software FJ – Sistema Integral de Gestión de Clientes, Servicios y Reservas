    def crear_tabla(self, padre, columnas, titulos, anchos):
        marco = ttk.Frame(padre)
        marco.pack(fill="both", expand=True)
        tabla = ttk.Treeview(marco, columns=columnas, show="headings")
        for col, titulo, ancho in zip(columnas, titulos, anchos):
            tabla.heading(col, text=titulo)
            tabla.column(col, width=ancho, minwidth=65)
        sy = ttk.Scrollbar(marco, orient="vertical", command=tabla.yview)
        sx = ttk.Scrollbar(marco, orient="horizontal", command=tabla.xview)
        tabla.configure(yscrollcommand=sy.set, xscrollcommand=sx.set)
        tabla.grid(row=0, column=0, sticky="nsew")
        sy.grid(row=0, column=1, sticky="ns")
        sx.grid(row=1, column=0, sticky="ew")
        marco.rowconfigure(0, weight=1)
        marco.columnconfigure(0, weight=1)
        return tabla

    def campo(self, padre, etiqueta, variable, fila, columna):
        ttk.Label(padre, text=etiqueta).grid(row=fila, column=columna, sticky="w", padx=5, pady=4)
        entrada = ttk.Entry(padre, textvariable=variable)
        entrada.grid(row=fila + 1, column=columna, sticky="ew", padx=5, pady=4)
        return entrada

