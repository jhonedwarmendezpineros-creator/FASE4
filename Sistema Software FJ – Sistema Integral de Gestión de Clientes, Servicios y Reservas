    prueba(12, "Rechazar procesamiento sin confirmar", op12)
    prueba(13, "Cancelar reserva pendiente", lambda: sistema.buscar_reserva("R005").cancelar())
    prueba(14, "Calcular impuesto y descuento", lambda: calcular_total(100000, 19, 10))
    prueba(15, "Rechazar impuesto superior a 100%", lambda: calcular_total(100000, 150))
    logging.info("Demostración de 15 operaciones finalizada.")
    return resultados


